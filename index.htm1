<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hot Tub Elite — 3D</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: Arial, Helvetica, sans-serif;
      background: #0b1118;
      color: white;
    }

    #scene {
      position: fixed;
      inset: 0;
    }

    .topbar {
      position: fixed;
      top: 24px;
      left: 28px;
      right: 28px;
      z-index: 10;

      display: flex;
      justify-content: space-between;
      align-items: center;

      pointer-events: none;
    }

    .brand {
      pointer-events: auto;

      padding: 14px 18px;

      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 16px;

      background: rgba(12,18,26,0.55);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);

      box-shadow: 0 10px 35px rgba(0,0,0,0.2);
    }

    .brand-title {
      margin: 0;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .brand-subtitle {
      margin-top: 4px;
      font-size: 12px;
      color: rgba(255,255,255,0.65);
    }

    .hero {
      position: fixed;
      left: 32px;
      bottom: 34px;
      z-index: 10;

      max-width: 470px;

      padding: 22px;

      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 22px;

      background: rgba(8,14,22,0.62);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      box-shadow: 0 20px 55px rgba(0,0,0,0.32);
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(28px, 4vw, 48px);
      line-height: 1;
    }

    .hero p {
      margin: 0 0 18px;

      color: rgba(255,255,255,0.72);

      font-size: 15px;
      line-height: 1.5;
    }

    .controls {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .color-btn,
    .action-btn {
      border: 0;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .color-btn:hover,
    .action-btn:hover {
      transform: translateY(-2px);
    }

    .color-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;

      border: 2px solid rgba(255,255,255,0.5);

      box-shadow:
        0 0 0 3px rgba(255,255,255,0.05),
        0 5px 15px rgba(0,0,0,0.25);
    }

    .action-btn {
      padding: 10px 14px;

      border-radius: 12px;

      background: rgba(255,255,255,0.1);
      color: white;

      font-weight: 600;

      border: 1px solid rgba(255,255,255,0.12);
    }

    .tip {
      position: fixed;
      right: 28px;
      bottom: 28px;
      z-index: 10;

      padding: 12px 15px;

      border-radius: 14px;

      background: rgba(8,14,22,0.52);
      backdrop-filter: blur(12px);

      color: rgba(255,255,255,0.7);

      font-size: 12px;

      border: 1px solid rgba(255,255,255,0.12);
    }

    @media (max-width: 700px) {
      .topbar {
        top: 14px;
        left: 14px;
        right: 14px;
      }

      .hero {
        left: 14px;
        right: 14px;
        bottom: 14px;
        max-width: none;
      }

      .tip {
        display: none;
      }

      .hero h1 {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <div id="scene"></div>

  <div class="topbar">
    <div class="brand">
      <div class="brand-title">Hot Tub Elite</div>
      <div class="brand-subtitle">Interactive 3D Experience</div>
    </div>
  </div>

  <section class="hero">
    <h1>Luxury Spa<br>in 3D</h1>

    <p>
      Вращайте модель мышкой, приближайте колёсиком
      и выбирайте цвет корпуса.
    </p>

    <div class="controls">

      <button
        class="color-btn"
        style="background:#eeeeea"
        data-color="#eeeeea"
        aria-label="White">
      </button>

      <button
        class="color-btn"
        style="background:#3e444b"
        data-color="#3e444b"
        aria-label="Graphite">
      </button>

      <button
        class="color-btn"
        style="background:#8b694d"
        data-color="#8b694d"
        aria-label="Wood">
      </button>

      <button
        class="color-btn"
        style="background:#101418"
        data-color="#101418"
        aria-label="Black">
      </button>

      <button class="action-btn" id="lightButton">
        LED подсветка
      </button>

      <button class="action-btn" id="resetButton">
        Сбросить вид
      </button>

    </div>
  </section>

  <div class="tip">
    Потяните мышью — вращение · Колёсико — приближение
  </div>

  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"
    }
  }
  </script>

  <script type="module">

    import * as THREE from "three";

    import {
      OrbitControls
    } from "three/addons/controls/OrbitControls.js";


    // -----------------------------
    // SCENE
    // -----------------------------

    const scene = new THREE.Scene();

    scene.background = new THREE.Color("#0b1118");

    scene.fog = new THREE.Fog(
      "#0b1118",
      12,
      28
    );


    // -----------------------------
    // CAMERA
    // -----------------------------

    const camera = new THREE.PerspectiveCamera(
      42,
      window.innerWidth / window.innerHeight,
      0.1,
      100
    );

    const defaultCameraPosition =
      new THREE.Vector3(6.4, 4.5, 7.2);

    camera.position.copy(defaultCameraPosition);


    // -----------------------------
    // RENDERER
    // -----------------------------

    const renderer =
      new THREE.WebGLRenderer({
        antialias: true,
        alpha: false
      });

    renderer.setPixelRatio(
      Math.min(
        window.devicePixelRatio,
        2
      )
    );

    renderer.setSize(
      window.innerWidth,
      window.innerHeight
    );

    renderer.shadowMap.enabled = true;

    renderer.shadowMap.type =
      THREE.PCFSoftShadowMap;

    renderer.outputColorSpace =
      THREE.SRGBColorSpace;

    renderer.toneMapping =
      THREE.ACESFilmicToneMapping;

    renderer.toneMappingExposure =
      1.05;

    document
      .getElementById("scene")
      .appendChild(
        renderer.domElement
      );


    // -----------------------------
    // CONTROLS
    // -----------------------------

    const controls =
      new OrbitControls(
        camera,
        renderer.domElement
      );

    controls.enableDamping = true;

    controls.dampingFactor = 0.05;

    controls.target.set(
      0,
      0.45,
      0
    );

    controls.minDistance = 4;

    controls.maxDistance = 12;

    controls.maxPolarAngle =
      Math.PI / 2.05;


    // -----------------------------
    // LIGHT
    // -----------------------------

    const ambient =
      new THREE.HemisphereLight(
        0xcfe7ff,
        0x111111,
        1.8
      );

    scene.add(ambient);


    const mainLight =
      new THREE.DirectionalLight(
        0xffffff,
        3.5
      );

    mainLight.position.set(
      5,
      8,
      5
    );

    mainLight.castShadow = true;

    mainLight.shadow.mapSize.width = 2048;

    mainLight.shadow.mapSize.height = 2048;

    scene.add(mainLight);


    const rimLight =
      new THREE.PointLight(
        0x49cfff,
        15,
        10
      );

    rimLight.position.set(
      -4,
      3,
      -3
    );

    scene.add(rimLight);


    // -----------------------------
    // FLOOR
    // -----------------------------

    const floor =
      new THREE.Mesh(

        new THREE.CircleGeometry(
          10,
          80
        ),

        new THREE.MeshStandardMaterial({
          color: 0x151c23,
          roughness: 0.82,
          metalness: 0.08
        })

      );

    floor.rotation.x =
      -Math.PI / 2;

    floor.position.y = -0.61;

    floor.receiveShadow = true;

    scene.add(floor);


    // -----------------------------
    // JACUZZI GROUP
    // -----------------------------

    const spa =
      new THREE.Group();

    scene.add(spa);


    // Корпус

    const bodyMaterial =
      new THREE.MeshPhysicalMaterial({
        color: 0xeeeeea,
        roughness: 0.32,
        metalness: 0.05,
        clearcoat: 0.5,
        clearcoatRoughness: 0.25
      });


    const body =
      new THREE.Mesh(

        new THREE.BoxGeometry(
          4.8,
          1.3,
          3.7,
          8,
          4,
          8
        ),

        bodyMaterial

      );

    body.position.y = 0;

    body.castShadow = true;

    body.receiveShadow = true;

    spa.add(body);


    // Верхний кант

    const rimMaterial =
      new THREE.MeshPhysicalMaterial({
        color: 0xf8f8f7,
        roughness: 0.22,
        clearcoat: 0.7
      });


    const rim =
      new THREE.Mesh(

        new THREE.BoxGeometry(
          5.05,
          0.22,
          3.95
        ),

        rimMaterial

      );

    rim.position.y = 0.72;

    rim.castShadow = true;

    spa.add(rim);


    // Внутренняя ванна

    const inner =
      new THREE.Mesh(

        new THREE.BoxGeometry(
          4.45,
          0.45,
          3.35
        ),

        new THREE.MeshPhysicalMaterial({
          color: 0xf7f7f4,
          roughness: 0.18,
          clearcoat: 0.8
        })

      );

    inner.position.y = 0.74;

    spa.add(inner);


    // Вода

    const waterMaterial =
      new THREE.MeshPhysicalMaterial({

        color: 0x21a8dc,

        transparent: true,

        opacity: 0.76,

        roughness: 0.05,

        metalness: 0,

        transmission: 0.18,

        thickness: 0.3,

        clearcoat: 1

      });


    const water =
      new THREE.Mesh(

        new THREE.PlaneGeometry(
          4.08,
          2.98,
          40,
          40
        ),

        waterMaterial

      );

    water.rotation.x =
      -Math.PI / 2;

    water.position.y = 1.02;

    spa.add(water);


    // -----------------------------
    // SEATS
    // -----------------------------

    const seatMaterial =
      new THREE.MeshStandardMaterial({
        color: 0xdededa,
        roughness: 0.3
      });


    function createSeat(x, z, rotation) {

      const seat =
        new THREE.Mesh(

          new THREE.BoxGeometry(
            1.15,
            0.18,
            0.85
          ),

          seatMaterial

        );

      seat.position.set(
        x,
        0.92,
        z
      );

      seat.rotation.y =
        rotation;

      seat.castShadow = true;

      spa.add(seat);

    }


    createSeat(
      -1.45,
      -0.95,
      0
    );

    createSeat(
      1.45,
      -0.95,
      0
    );

    createSeat(
      -1.45,
      0.95,
      0
    );

    createSeat(
      1.45,
      0.95,
      0
    );


    // -----------------------------
    // JETS
    // -----------------------------

    const jetMaterial =
      new THREE.MeshStandardMaterial({
        color: 0xc6ced5,
        metalness: 0.85,
        roughness: 0.18
      });


    function createJet(
      x,
      y,
      z
    ) {

      const jet =
        new THREE.Mesh(

          new THREE.CylinderGeometry(
            0.09,
            0.09,
            0.05,
            24
          ),

          jetMaterial

        );

      jet.rotation.x =
        Math.PI / 2;

      jet.position.set(
        x,
        y,
        z
      );

      spa.add(jet);

    }


    for (
      let x = -1.5;
      x <= 1.5;
      x += 0.5
    ) {

      createJet(
        x,
        0.98,
        -1.22
      );

    }


    // -----------------------------
    // LED STRIP
    // -----------------------------

    const ledMaterial =
      new THREE.MeshStandardMaterial({

        color: 0x00bfff,

        emissive: 0x00bfff,

        emissiveIntensity: 2.8

      });


    const led =
      new THREE.Mesh(

        new THREE.BoxGeometry(
          4.25,
          0.04,
          3.12
        ),

        ledMaterial

      );

    led.position.y = 1.035;

    spa.add(led);


    // вода сверху должна быть видна

    water.position.y = 1.06;


    // -----------------------------
    // BUBBLES
    // -----------------------------

    const bubbles = [];

    const bubbleMaterial =
      new THREE.MeshPhysicalMaterial({

        color: 0xffffff,

        transparent: true,

        opacity: 0.45,

        roughness: 0

      });


    for (
      let i = 0;
      i < 45;
      i++
    ) {

      const bubble =
        new THREE.Mesh(

          new THREE.SphereGeometry(
            0.025 +
            Math.random() * 0.04,
            12,
            12
          ),

          bubbleMaterial

        );

      bubble.position.set(

        -1.8 +
        Math.random() * 3.6,

        1.08 +
        Math.random() * 0.12,

        -1.25 +
        Math.random() * 2.5

      );

      spa.add(bubble);

      bubbles.push({
        mesh: bubble,
        speed:
          0.002 +
          Math.random() * 0.004,
        phase:
          Math.random() *
          Math.PI * 2
      });

    }


    // -----------------------------
    // COLOR BUTTONS
    // -----------------------------

    document
      .querySelectorAll(
        ".color-btn"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              const color =
                button.dataset.color;

              bodyMaterial.color.set(
                color
              );

            }
          );

        }
      );


    // -----------------------------
    // LED BUTTON
    // -----------------------------

    let ledEnabled = true;

    const lightButton =
      document.getElementById(
        "lightButton"
      );

    lightButton.addEventListener(
      "click",
      () => {

        ledEnabled =
          !ledEnabled;

        ledMaterial.emissiveIntensity =
          ledEnabled
          ? 2.8
          : 0;

        rimLight.intensity =
          ledEnabled
          ? 15
          : 0;

        lightButton.textContent =
          ledEnabled
          ? "LED подсветка"
          : "Включить LED";

      }
    );


    // -----------------------------
    // RESET CAMERA
    // -----------------------------

    document
      .getElementById(
        "resetButton"
      )
      .addEventListener(
        "click",
        () => {

          camera.position.copy(
            defaultCameraPosition
          );

          controls.target.set(
            0,
            0.45,
            0
          );

          controls.update();

        }
      );


    // -----------------------------
    // ANIMATION
    // -----------------------------

    const clock =
      new THREE.Clock();


    function animate() {

      requestAnimationFrame(
        animate
      );

      const time =
        clock.getElapsedTime();


      // лёгкое движение воды

      water.position.y =
        1.06 +
        Math.sin(
          time * 1.8
        ) * 0.008;


      // пузырьки

      bubbles.forEach(
        bubble => {

          bubble.mesh.position.y =
            1.10 +
            Math.sin(
              time * 2 +
              bubble.phase
            ) * 0.05;

          bubble.mesh.position.x +=
            Math.sin(
              time +
              bubble.phase
            ) *
            bubble.speed;

        }
      );


      controls.update();

      renderer.render(
        scene,
        camera
      );

    }


    animate();


    // -----------------------------
    // RESIZE
    // -----------------------------

    window.addEventListener(
      "resize",
      () => {

        camera.aspect =
          window.innerWidth /
          window.innerHeight;

        camera
          .updateProjectionMatrix();

        renderer.setSize(
          window.innerWidth,
          window.innerHeight
        );

      }
    );

  </script>

</body>
</html>
